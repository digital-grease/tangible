{
  "openapi": "3.1.0",
  "info": {
    "title": "Tangible",
    "description": "Self-hosted disc-image preservation, management, and burning.",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/artifacts": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "List artifacts, newest identifiers last.",
        "description": "List artifacts in creation order. Use `next_cursor` from the response to fetch the following page.",
        "operationId": "list_artifacts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum items to return. Clamped to [`MAX_LIMIT`].",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from a previous response's `next_cursor`.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of artifacts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactSummaryPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Library unreadable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{artifact_id}": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "One artifact in detail.",
        "description": "Fetch one artifact with its components and any structural findings.",
        "operationId": "get_artifact",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "description": "Artifact identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The artifact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such artifact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Stored manifest is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{artifact_id}/components": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "The artifact's components.",
        "description": "List the files making up an artifact.",
        "operationId": "list_components",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "description": "Artifact identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The components",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ComponentView"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such artifact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{artifact_id}/manifest": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "The artifact's full manifest, exactly as stored.",
        "description": "Fetch the artifact manifest exactly as stored, byte for byte.",
        "operationId": "get_manifest",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "description": "Artifact identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The manifest document"
          },
          "404": {
            "description": "No such artifact",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/burn-attempts/{attempt_id}/complete": {
      "post": {
        "tags": [
          "workers"
        ],
        "summary": "Record the end of an attempt.",
        "description": "Record the end of an attempt. Idempotent: retrying after a lost response returns the same physical copy rather than recording a second disc.",
        "operationId": "complete",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "description": "Attempt identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such leased attempt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "worker_credential": []
          }
        ]
      }
    },
    "/api/v1/burn-attempts/{attempt_id}/events": {
      "post": {
        "tags": [
          "workers"
        ],
        "summary": "Submit worker events.",
        "description": "Submit worker events. Idempotent by sequence: resubmitting a batch already held changes nothing.",
        "operationId": "submit_events",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "description": "Attempt identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAck"
                }
              }
            }
          },
          "400": {
            "description": "Malformed batch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "worker_credential": []
          }
        ]
      }
    },
    "/api/v1/burn-attempts/{attempt_id}/lease/renew": {
      "post": {
        "tags": [
          "workers"
        ],
        "summary": "Extend a lease.",
        "description": "Extend a lease. A refusal does not interrupt a write already in progress; it only prevents claiming more work.",
        "operationId": "renew",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "description": "Attempt identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Renewed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenewResponse"
                }
              }
            }
          },
          "404": {
            "description": "No renewable attempt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "worker_credential": []
          }
        ]
      }
    },
    "/api/v1/worker-enrollments/consume": {
      "post": {
        "tags": [
          "workers"
        ],
        "summary": "Exchange a one-use enrollment token for a worker credential.",
        "description": "Exchange a one-use enrollment token for a worker credential. The credential is returned once and cannot be recovered.",
        "operationId": "consume_enrollment_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Enrolled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "No shared protocol version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "The token is not usable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The name is already in use",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workers/{worker_id}/claims": {
      "post": {
        "tags": [
          "workers"
        ],
        "summary": "Ask for work.",
        "description": "Ask for a burn job. Answers 204 when there is nothing to do.",
        "operationId": "claim_work",
        "parameters": [
          {
            "name": "worker_id",
            "in": "path",
            "description": "Worker identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Work leased",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            }
          },
          "204": {
            "description": "Nothing to do"
          },
          "404": {
            "description": "Not this worker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The drive is already busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "worker_credential": []
          }
        ]
      }
    },
    "/api/v1/workers/{worker_id}/heartbeat": {
      "post": {
        "tags": [
          "workers"
        ],
        "summary": "Report that a worker is alive.",
        "description": "Report that a worker is alive and receive any instruction to stop taking new work.",
        "operationId": "heartbeat",
        "parameters": [
          {
            "name": "worker_id",
            "in": "path",
            "description": "Worker identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not this worker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "worker_credential": []
          }
        ]
      }
    },
    "/api/v1/workers/{worker_id}/recoveries": {
      "post": {
        "tags": [
          "workers"
        ],
        "summary": "Reconcile a worker that restarted holding local state.",
        "description": "Reconcile a worker that restarted holding local state. No directive ever permits writing.",
        "operationId": "recover",
        "parameters": [
          {
            "name": "worker_id",
            "in": "path",
            "description": "Worker identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Directive issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not this worker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "worker_credential": []
          }
        ]
      }
    },
    "/livez": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness probe: the process is running and the runtime is responsive.",
        "description": "Liveness. Answers whenever the process can serve a request and deliberately checks no dependency, so a database outage cannot cause a restart loop.",
        "operationId": "livez",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness probe: every dependency needed to serve traffic is usable.",
        "description": "Readiness. Answers 503 when any dependency is unusable so that traffic is withheld rather than sent into failure.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "All dependencies usable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactSummary",
            "description": "Summary fields."
          },
          {
            "type": "object",
            "required": [
              "format_confidence",
              "source_kind",
              "warnings",
              "components"
            ],
            "properties": {
              "components": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ComponentView"
                },
                "description": "The files making up the artifact."
              },
              "format_confidence": {
                "type": "number",
                "format": "float",
                "description": "Detection confidence, from 0 to 1. Diagnostic only."
              },
              "source_kind": {
                "type": "string",
                "description": "Where the bytes came from."
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Structural findings, if any."
              }
            }
          }
        ],
        "description": "Everything known about one artifact, short of its full manifest."
      },
      "ArtifactSummary": {
        "type": "object",
        "description": "An artifact as it appears in a listing.\n\nDeliberately not the whole manifest: a listing of a large library should\nnot carry every component of every artifact.",
        "required": [
          "id",
          "format",
          "artifact_kind",
          "validation_state",
          "component_count",
          "total_bytes",
          "has_warnings"
        ],
        "properties": {
          "artifact_kind": {
            "type": "string",
            "description": "Shape of the artifact."
          },
          "component_count": {
            "type": "integer",
            "description": "Number of files.",
            "minimum": 0
          },
          "format": {
            "type": "string",
            "description": "Detected container format."
          },
          "has_warnings": {
            "type": "boolean",
            "description": "Whether anything structural is worth an operator's attention.\n\nSurfaced in the summary so a damaged artifact is visible in a list\nwithout opening it."
          },
          "id": {
            "type": "string",
            "description": "Opaque identifier."
          },
          "source_filename": {
            "type": [
              "string",
              "null"
            ],
            "description": "Filename as received, when one was recorded."
          },
          "total_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Total size of all components.",
            "minimum": 0
          },
          "validation_state": {
            "type": "string",
            "description": "Structural validation outcome."
          }
        }
      },
      "ArtifactSummaryPage": {
        "type": "object",
        "description": "A page of artifact summaries.\n\nA concrete type rather than a generic instantiation so the published\nOpenAPI names something a client generator can produce cleanly.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtifactSummary"
            },
            "description": "The artifacts in this page."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor for the next page, or null when this is the last."
          }
        }
      },
      "ClaimRequest": {
        "type": "object",
        "description": "What a worker offers when asking for work.",
        "required": [
          "drive_id",
          "engine",
          "engine_version"
        ],
        "properties": {
          "drive_id": {
            "type": "string",
            "description": "The drive the work would run on."
          },
          "engine": {
            "type": "string",
            "description": "The engine the worker would use."
          },
          "engine_version": {
            "type": "string",
            "description": "That engine's version."
          }
        }
      },
      "ClaimResponse": {
        "type": "object",
        "description": "A lease on some work.",
        "required": [
          "attempt_id",
          "burn_job_id",
          "attempt_number",
          "artifact_id",
          "lease_token",
          "lease_expires_at",
          "verification_policy"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "description": "The artifact to write."
          },
          "attempt_id": {
            "type": "string",
            "description": "The attempt created for this claim."
          },
          "attempt_number": {
            "type": "integer",
            "format": "int32",
            "description": "Which attempt this is."
          },
          "burn_job_id": {
            "type": "string",
            "description": "The job."
          },
          "lease_expires_at": {
            "type": "string",
            "description": "When the lease lapses."
          },
          "lease_token": {
            "type": "string",
            "description": "The lease token, presented on subsequent requests for this attempt."
          },
          "verification_policy": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Verification steps the job requires."
          }
        }
      },
      "CompletionRequest": {
        "type": "object",
        "description": "What a worker sends when it finishes.",
        "required": [
          "lease_token",
          "last_sequence",
          "write_report",
          "physical_medium"
        ],
        "properties": {
          "last_sequence": {
            "type": "integer",
            "format": "int64",
            "description": "The last event sequence the worker emitted."
          },
          "lease_token": {
            "type": "string",
            "description": "The lease token from the claim."
          },
          "physical_medium": {
            "$ref": "#/components/schemas/PhysicalMedium",
            "description": "What was in the drive."
          },
          "verification_report": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/VerificationReport",
                "description": "The read-back comparison, when one ran."
              }
            ]
          },
          "write_report": {
            "$ref": "#/components/schemas/WriteReport",
            "description": "The engine's account of the write."
          }
        }
      },
      "CompletionResponse": {
        "type": "object",
        "description": "What the server acknowledges.",
        "required": [
          "acknowledged",
          "eject"
        ],
        "properties": {
          "acknowledged": {
            "type": "boolean",
            "description": "Always true when the server has the completion recorded."
          },
          "eject": {
            "type": "boolean",
            "description": "Whether the drive should eject."
          },
          "physical_copy_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The disc recorded, when the attempt consumed media."
          }
        }
      },
      "ComponentView": {
        "type": "object",
        "description": "One file within an artifact.",
        "required": [
          "logical_path",
          "role",
          "ordinal",
          "length_bytes",
          "sha256"
        ],
        "properties": {
          "length_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Size in bytes.",
            "minimum": 0
          },
          "logical_path": {
            "type": "string",
            "description": "Portable path inside the artifact."
          },
          "ordinal": {
            "type": "integer",
            "format": "int32",
            "description": "Position within the artifact.",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "description": "What part it plays."
          },
          "sha256": {
            "type": "string",
            "description": "Content digest, as lowercase hex."
          }
        }
      },
      "DependencyCheck": {
        "type": "object",
        "description": "The state of one dependency.",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Operator-facing failure summary. Never carries a connection string or\ncredential, only the error class."
          },
          "name": {
            "type": "string",
            "description": "Dependency name, e.g. `\"database\"`."
          },
          "status": {
            "type": "string",
            "description": "`\"up\"` or `\"down\"`."
          }
        }
      },
      "EnrollmentRequest": {
        "type": "object",
        "description": "What a worker sends to enroll.",
        "required": [
          "enrollment_token",
          "name",
          "protocol_versions",
          "software_version"
        ],
        "properties": {
          "enrollment_token": {
            "type": "string",
            "description": "The one-use token an administrator issued."
          },
          "name": {
            "type": "string",
            "description": "A human-meaningful name for this worker."
          },
          "protocol_versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Protocol versions the worker speaks."
          },
          "software_version": {
            "type": "string",
            "description": "The worker's software version."
          }
        }
      },
      "EnrollmentResponse": {
        "type": "object",
        "description": "What a newly enrolled worker receives.",
        "required": [
          "worker_id",
          "protocol_version",
          "credential",
          "heartbeat_interval_seconds",
          "lease_duration_seconds"
        ],
        "properties": {
          "credential": {
            "type": "string",
            "description": "The credential, returned exactly once and never recoverable."
          },
          "heartbeat_interval_seconds": {
            "type": "integer",
            "format": "int64",
            "description": "How often to report in."
          },
          "lease_duration_seconds": {
            "type": "integer",
            "format": "int64",
            "description": "How long a lease lasts."
          },
          "protocol_version": {
            "type": "string",
            "description": "The protocol version the server selected."
          },
          "worker_id": {
            "type": "string",
            "description": "Its identity."
          }
        }
      },
      "EventAck": {
        "type": "object",
        "description": "What the server has persisted.",
        "required": [
          "accepted_through_sequence"
        ],
        "properties": {
          "accepted_through_sequence": {
            "type": "integer",
            "format": "int64",
            "description": "The highest contiguous sequence held. The worker prunes against this."
          }
        }
      },
      "EventBatch": {
        "type": "object",
        "description": "A batch of events.",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventSubmission"
            },
            "description": "The events, in sequence order."
          }
        }
      },
      "EventSubmission": {
        "type": "object",
        "description": "One event in a submitted batch.",
        "required": [
          "sequence",
          "event_type",
          "stage",
          "code",
          "worker_time"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code."
          },
          "data": {
            "description": "Structured detail."
          },
          "event_type": {
            "type": "string",
            "description": "Event type."
          },
          "progress": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "Progress from 0 to 1, when reported."
          },
          "sequence": {
            "type": "integer",
            "format": "int64",
            "description": "Monotonic within the attempt."
          },
          "stage": {
            "type": "string",
            "description": "Stage it relates to."
          },
          "worker_time": {
            "type": "string",
            "description": "When the worker observed it."
          }
        }
      },
      "HeartbeatResponse": {
        "type": "object",
        "description": "What the server tells a worker on each heartbeat.",
        "required": [
          "server_time",
          "drain"
        ],
        "properties": {
          "drain": {
            "type": "boolean",
            "description": "Whether the worker should stop taking new work."
          },
          "server_time": {
            "type": "string",
            "description": "The server's clock, so a worker can notice drift."
          }
        }
      },
      "Liveness": {
        "type": "object",
        "description": "Result of a liveness probe.",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `\"alive\"` when the process can serve a request at all."
          },
          "version": {
            "type": "string",
            "description": "Server version, from the crate version at build time."
          }
        }
      },
      "PhysicalMedium": {
        "type": "object",
        "description": "What was in the drive.",
        "required": [
          "profile"
        ],
        "properties": {
          "manufacturer_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Manufacturer identifier, when the drive reported one."
          },
          "profile": {
            "type": "string",
            "description": "Media profile, such as `bd-r-25`."
          },
          "serial": {
            "type": [
              "string",
              "null"
            ],
            "description": "Media serial, when the drive reported one."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem document.",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code. Clients branch on this, not on `detail`."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation. May be reworded between releases."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "The request path, when known."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code, repeated in the body as the RFC allows.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary."
          },
          "type": {
            "type": "string",
            "description": "A URI identifying the problem type."
          }
        }
      },
      "Readiness": {
        "type": "object",
        "description": "Result of a readiness probe.",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "description": "Per-dependency detail, so an operator can see *what* is failing."
          },
          "status": {
            "type": "string",
            "description": "`\"ready\"` when every dependency is usable, otherwise `\"degraded\"`."
          }
        }
      },
      "RecoveryRequest": {
        "type": "object",
        "description": "What a worker reports when it restarts holding local state.",
        "required": [
          "attempt_id",
          "local_stage",
          "last_event_sequence",
          "engine_process_state"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "description": "The attempt the worker was running."
          },
          "engine_process_state": {
            "type": "string",
            "description": "Whether the engine process is still running."
          },
          "last_event_sequence": {
            "type": "integer",
            "format": "int64",
            "description": "The last event sequence it emitted."
          },
          "local_stage": {
            "type": "string",
            "description": "The stage the worker believes it reached."
          }
        }
      },
      "RecoveryResponse": {
        "type": "object",
        "description": "What the worker must do.",
        "required": [
          "directive",
          "discard_local_state",
          "may_accept_new_work",
          "may_write"
        ],
        "properties": {
          "directive": {
            "type": "string",
            "description": "One of the protocol's recovery directives."
          },
          "discard_local_state": {
            "type": "boolean",
            "description": "Whether local state may be dropped."
          },
          "may_accept_new_work": {
            "type": "boolean",
            "description": "Whether the worker may take new work."
          },
          "may_write": {
            "type": "boolean",
            "description": "Always false. Restarting a write is never a recovery action."
          }
        }
      },
      "RenewRequest": {
        "type": "object",
        "description": "What a worker sends to renew.",
        "required": [
          "lease_token"
        ],
        "properties": {
          "lease_token": {
            "type": "string",
            "description": "The lease token from the claim."
          }
        }
      },
      "RenewResponse": {
        "type": "object",
        "description": "The renewed lease.",
        "required": [
          "lease_expires_at"
        ],
        "properties": {
          "lease_expires_at": {
            "type": "string",
            "description": "The new expiry."
          }
        }
      },
      "VerificationReport": {
        "type": "object",
        "description": "The read-back comparison, when one ran.",
        "required": [
          "policy",
          "state",
          "bytes_read",
          "expected_sha256",
          "observed_sha256"
        ],
        "properties": {
          "bytes_read": {
            "type": "integer",
            "format": "int64",
            "description": "How much was read back."
          },
          "expected_sha256": {
            "type": "string",
            "description": "The digest the artifact should have."
          },
          "observed_sha256": {
            "type": "string",
            "description": "The digest actually read from the disc."
          },
          "policy": {
            "type": "string",
            "description": "Which verification ran."
          },
          "state": {
            "type": "string",
            "description": "`match`, `mismatch`, or `skipped`."
          }
        }
      },
      "WriteReport": {
        "type": "object",
        "description": "The engine's account of the write.",
        "required": [
          "state",
          "engine",
          "engine_version",
          "started_at",
          "completed_at"
        ],
        "properties": {
          "completed_at": {
            "type": "string",
            "description": "When it ended."
          },
          "engine": {
            "type": "string",
            "description": "Which engine wrote."
          },
          "engine_version": {
            "type": "string",
            "description": "That engine's version."
          },
          "started_at": {
            "type": "string",
            "description": "When writing began."
          },
          "state": {
            "type": "string",
            "description": "`success` or a failure description."
          }
        }
      }
    },
    "securitySchemes": {
      "worker_credential": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "operations",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "library",
      "description": "Artifacts and their components"
    },
    {
      "name": "workers",
      "description": "The burn-worker protocol"
    }
  ]
}
