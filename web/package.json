    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.18.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^4.0.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
