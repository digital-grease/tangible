#
# Copy to .env and edit. Never commit .env.

# Required. The stack refuses to start without it.
POSTGRES_PASSWORD=change-me

# Externally reachable base URL. Its scheme decides the session cookie: https
# marks it Secure; plain http works on a trusted LAN and logs a warning at
# every start (deploy/README.md, "First sign-in").
TANGIBLE_PUBLIC_URL=http://localhost:8080

# Host port for the web UI and API.
TANGIBLE_HTTP_PORT=8080

# Tracing filter.
TANGIBLE_LOG=tangible=info,tower_http=info

# Directories the server may import from, as id=path,id=path. The identifiers
# are what the API and the UI use; the paths never leave the server. Empty by
# default, which is the safe value: with none configured, no request can name a
# path on this host at all.
#
# Mount each one into the server container as well, at the same path.
# TANGIBLE_WATCH_ROOTS=incoming=/srv/incoming

# Watched roots Tangible may delete in, by id: a SABnzbd or NZBGet finished
# folder whose downloads are deleted once imported and checked, for an
# integration set to remove after import. Empty by default, so every watched
# root is only read. Mount each one listed read-write.
# TANGIBLE_REMOVABLE_ROOTS=usenet

# Largest upload accepted, in bytes. Defaults to 64 GiB.
# TANGIBLE_MAX_UPLOAD_BYTES=68719476736

# What makes derivatives, such as a CHD of a disc image: chdman (the default,
# carried by the image) or none. A derivative is made only when somebody asks
# for one of a particular artifact; the original is never changed.
# TANGIBLE_DERIVATION_ENGINE=chdman

# Issue reports. Operators can turn a failed burn or an error into a
# prefilled GitHub issue: the server prepares the text with credentials,
# paths, serial numbers and library file names replaced, the operator reads
# all of it, and their own browser opens the issue form. The server never
# sends anything. Set the address empty to stop offering reports, or point it
# at your own tracker if you run a modified Tangible. IP addresses and private
# host names are replaced too unless the second setting is false.
# TANGIBLE_REPORT_ISSUES_URL=https://github.com/digital-grease/tangible/issues/new
# TANGIBLE_REPORT_SCRUB_ADDRESSES=true

# Rip decryption. Lets operators ask a rip to decrypt an encrypted
# disc, on a worker run from an image you built to decrypt (deploy/README.md,
# "Ripping encrypted discs"). Whether ripping a disc is lawful where you are
# is yours to determine. Off unless set to true.
# TANGIBLE_ALLOW_DECRYPTION=false

# Importing from a URL. Lets operators have the server fetch a file
# and import it. Off unless set to true. Fetches reach public addresses over
# https only, unless you allow plain http, list private blocks the server may
# reach (comma-separated CIDRs), or send them through a proxy that must then
# enforce the same (deploy/README.md, "Importing from a URL").
# TANGIBLE_URL_IMPORTS=false
# TANGIBLE_URL_IMPORTS_ALLOW_HTTP=false
# TANGIBLE_OUTBOUND_ALLOW=
# TANGIBLE_OUTBOUND_PROXY=

# Integrity scrubs. Days after a full scrub of the library ends before the
# server queues the next (deploy/README.md, "Checking stored bytes"). A scrub
# reads every stored byte, so it is off (0) unless you set it.
# TANGIBLE_SCRUB_INTERVAL_DAYS=0

# Preservation hashes: the CRC32, MD5 and SHA-1 of every artifact's files and
# CD tracks, which DATs such as Redump's list, computed in the background by
# reading each artifact's stored bytes once (those already in the library
# too). On unless set to false.
# TANGIBLE_PRESERVATION_HASHES=true

# Signing in through an OpenID Connect provider (deploy/README.md, "Signing in
# through an identity provider"). Off unless the issuer is set. Register
# Tangible at the provider with the callback
# <TANGIBLE_PUBLIC_URL>/api/v1/session/oidc/callback; the client secret is a
# file set in compose.yaml, never here. Someone in none of the mapped groups is
# refused.
# TANGIBLE_OIDC_ISSUER=https://auth.example.lan
# TANGIBLE_OIDC_CLIENT_ID=tangible
# TANGIBLE_OIDC_DISPLAY_NAME=VoidAuth
# TANGIBLE_OIDC_ADMIN_GROUPS=tangible-admins
# TANGIBLE_OIDC_OPERATOR_GROUPS=tangible-operators
# TANGIBLE_OIDC_VIEWER_GROUPS=
# Who may sign in with a password: all, or setup-only (only the administrator
# setup made, for when the provider is down).
# TANGIBLE_PASSWORD_SIGN_IN=all

# Metrics: set in compose.yaml, not here (deploy/README.md, "Metrics"). The
# listener is off unless TANGIBLE_METRICS_BIND is set, and its token is a file
# mounted as a Compose secret.

# Integration secrets: set in compose.yaml, not here, because the
# key is a file mounted as a Compose secret (deploy/README.md, "Integration
# secrets"). Never put the key itself in this file.

# RomM export: set in compose.yaml, not here, because it needs a volume as well
# (deploy/README.md, "Showing games in RomM").

# --- Hardware override only (deploy/compose.hardware.yaml) -------------------
# Leave these unset unless you are running a real burn worker.
#
# Find your drive with:  ls -l /dev/sr*
# TANGIBLE_BLOCK_DEVICE=/dev/sr0
# TANGIBLE_WORKER_NAME=pioneer-bdr-212
#
# Only with compose.hardware-sg.yaml, for a drive that needs its generic SCSI
# node as well. Find the pairing with `lsscsi -g`; do not guess it.
# TANGIBLE_SCSI_DEVICE=/dev/sg4
#
# The numeric group that owns the drive on this host. The worker runs as an
# unprivileged user and is refused the drive without it. It differs between
# distributions (`optical` on Arch, `cdrom` on Debian and Ubuntu), so find it
# rather than guess:  stat -c %g /dev/sr0
# TANGIBLE_OPTICAL_GID=990
#
# A one-use enrollment token, needed only on the worker's first start. An
# administrator issues one from the web UI's Workers page, or with
# POST /api/v1/worker-enrollments after signing in (deploy/README.md, "First
# sign-in"). It lasts 15 minutes unless asked for up to 60. Start the worker,
# then remove it again: the credential the worker exchanges it for lives on
# the worker's volume and is never recoverable from the server.
# TANGIBLE_ENROLLMENT_TOKEN=tgw_enroll_...
#
# A worker reaches its server over plain HTTP only where the server's address
# is loopback or on a network the worker's container is attached to, as the
# Compose network in compose.hardware.yaml is. A worker on another machine
# needs an https:// server URL, or this set to true to accept plain HTTP
# across the network, credential and images unencrypted (deploy/README.md,
# "A worker on another machine"). Leave it unset unless you mean that.
# TANGIBLE_WORKER_PLAIN_HTTP=false
#
# The burn engine for the worker. `fake` writes to a file and touches no
# drive. `auto` writes to the mapped drive: ISO images through xorriso, read
# back and compared afterwards, and CUE/BIN discs through cdrdao, which are
# recorded as written and unverified because reading those back is not built
# yet. `xorriso` and `cdrdao` run one engine alone, and a worker running one
# alone fails jobs of the other kind. Left as fake by default, so starting a
# worker does not write to a disc somebody left in the tray.
# TANGIBLE_BURN_ENGINE=auto
#
# Only with compose.decryption.yaml: the tag of the worker image you built
# from deploy/decryption/Dockerfile to rip encrypted discs (deploy/README.md,
# "Ripping encrypted discs"). Never pulled; Compose stops if it is unset.
# TANGIBLE_DECRYPTION_IMAGE=tangible-decryption:v0.1.0
