#
# Copy to .env and edit. Never commit .env.

# Required. The stack refuses to start without it.
POSTGRES_PASSWORD=change-me

# Externally reachable base URL.
TANGIBLE_PUBLIC_URL=http://localhost:8080

# Host port for the web UI and API.
TANGIBLE_HTTP_PORT=8080

# Tracing filter.
TANGIBLE_LOG=tangible=info,tower_http=info

# Directories the server may import from, as id=path,id=path. The identifiers
# are what the API and the UI use; the paths never leave the server. Empty by
# default, which is the safe value: with none configured, no request can name a
# path on this host at all.
#
# Mount each one into the server container as well, at the same path.
# TANGIBLE_WATCH_ROOTS=incoming=/srv/incoming

# Largest upload accepted, in bytes. Defaults to 64 GiB.
# TANGIBLE_MAX_UPLOAD_BYTES=68719476736

# --- Hardware override only (deploy/compose.hardware.yaml) -------------------
# Leave these unset unless you are running a real burn worker.
#
# Find the pair for your drive with:  ls -l /dev/sr* /dev/sg*
# TANGIBLE_BLOCK_DEVICE=/dev/sr0
# TANGIBLE_SCSI_DEVICE=/dev/sg4
# TANGIBLE_WORKER_NAME=pioneer-bdr-212
#
# A one-use enrollment token, needed only on the worker's first start. Issue
# one from the workers page, start the worker, then remove it again: the
# credential the worker exchanges it for lives on the worker's volume and is
# never recoverable from the server.
# TANGIBLE_ENROLLMENT_TOKEN=tgw_enroll_...
#
# The burn engine for the worker. `fake` writes to a file and touches no
# drive; `xorriso` writes ISO images to the mapped device. Left as fake by
# default, so starting a worker does not write to a disc somebody left in the
# tray.
# TANGIBLE_BURN_ENGINE=xorriso
