#
# For compose.worker.yaml, on a machine with a drive and no server: copy to
# .env beside it and edit. Never commit .env. The server's machine uses
# .env.example instead.

# Required. The server's address as this machine reaches it, normally its
# TANGIBLE_PUBLIC_URL. Use https://: the worker refuses a plain http:// address
# that leaves this machine unless TANGIBLE_WORKER_PLAIN_HTTP is true.
TANGIBLE_SERVER_URL=https://tangible.example.lan

# Required. The name an operator sees for this drive.
TANGIBLE_WORKER_NAME=pioneer-bdr-212

# The image the worker runs. Unset, it is the one compose.worker.yaml names:
# its minor version's tag, which each patch release moves, so `docker compose
# pull` takes the newest patch. Keep it the server's version. Set it to a
# digest from the release page to run exactly the image you verified, and
# change it to upgrade.
# TANGIBLE_IMAGE=ghcr.io/digital-grease/tangible@sha256:<digest from the release page>

# Required. The numeric group that owns the drive on this machine. The worker
# runs as an unprivileged user and is refused the drive without it. It differs
# between distributions (`optical` on Arch, `cdrom` on Debian and Ubuntu), so
# find it rather than guess:  stat -L -c %g /dev/disk/by-id/NAME  (-L, or
# stat reads the link, which root owns, and not the drive)
TANGIBLE_OPTICAL_GID=

# The drive, by its name under /dev/disk/by-id, which stays with it when it is
# plugged in again or the machine restarts (/dev/sr0 can come back as
# /dev/sr1); restarting the worker is then enough. Find it with:
#   ls -l /dev/disk/by-id/ | grep -E 'sr[0-9]+$'
# TANGIBLE_BLOCK_DEVICE=/dev/disk/by-id/ata-PIONEER_BD-RW_BDR-212M_SJDL012345WL

# A one-use enrollment token, needed only on the worker's first start. An
# administrator issues one from the web UI's Workers page. It lasts 15 minutes
# unless asked for up to 60. Start the worker, then remove it again: the
# credential the worker exchanges it for lives on the worker's volume.
# TANGIBLE_ENROLLMENT_TOKEN=tgw_enroll_...

# The burn engine. `fake` writes to a file and touches no drive. `auto` writes
# to the mapped drive: ISO images through xorriso, read back and compared
# afterwards, and CUE/BIN discs through cdrdao, read back track by track
# (MODE1/2048 data compared, audio and other tracks checked for length and
# readability). Left as fake by default, so starting a worker does not write
# to a disc somebody left in the tray.
# TANGIBLE_BURN_ENGINE=auto

# Plain HTTP across the network, the credential and every image unencrypted.
# Leave it false unless you mean that, on a network you trust.
# TANGIBLE_WORKER_PLAIN_HTTP=false

# Only with compose.hardware-sg.yaml, for a drive that needs its generic SCSI
# node as well. Find the pairing with `lsscsi -g`; do not guess it.
# TANGIBLE_SCSI_DEVICE=/dev/sg4

# Only with compose.decryption.yaml: the tag of the worker image you built
# from decryption/Dockerfile to rip encrypted discs (deploy/README.md,
# "Ripping encrypted discs"). Never pulled; Compose stops if it is unset.
# TANGIBLE_DECRYPTION_IMAGE=tangible-decryption:v0.4.0

# Tracing filter.
# TANGIBLE_LOG=tangible=info
